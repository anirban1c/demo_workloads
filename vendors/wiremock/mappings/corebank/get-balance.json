{
  "name": "corebank get-balance",
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/corebank/accounts/[^/]+/balance"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "delayDistribution": {
      "type": "lognormal",
      "median": 150,
      "sigma": 0.4
    },
    "jsonBody": {
      "accountId": "{{request.pathSegments.[2]}}",
      "available": "{{randomInt lower=0 upper=5000}}.00",
      "currency": "GBP"
    },
    "transformers": [
      "response-template"
    ]
  },
  "metadata": {
    "vendor": "corebank",
    "kind": "base"
  }
}