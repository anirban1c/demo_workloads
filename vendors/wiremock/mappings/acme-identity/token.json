{
  "name": "acme-identity token",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/identity/oauth2/token"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "delayDistribution": {
      "type": "lognormal",
      "median": 80,
      "sigma": 0.4
    },
    "jsonBody": {
      "access_token": "eyJ{{randomValue length=40 type='ALPHANUMERIC'}}",
      "token_type": "Bearer",
      "expires_in": 3600,
      "scope": "openid profile"
    },
    "transformers": [
      "response-template"
    ]
  },
  "metadata": {
    "vendor": "acme-identity",
    "kind": "base"
  }
}