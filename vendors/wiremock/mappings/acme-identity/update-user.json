{
  "name": "acme-identity update-user",
  "priority": 5,
  "request": {
    "method": "PATCH",
    "urlPathPattern": "/identity/users/[^/]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "delayDistribution": {
      "type": "lognormal",
      "median": 90,
      "sigma": 0.4
    },
    "jsonBody": {
      "id": "{{request.pathSegments.[2]}}",
      "status": "UPDATED"
    },
    "transformers": [
      "response-template"
    ]
  },
  "metadata": {
    "vendor": "acme-identity",
    "kind": "base"
  }
}